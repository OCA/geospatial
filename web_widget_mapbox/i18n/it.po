#. module: web_widget_mapbox
#: model:ir.model.fields,help:web_widget_mapbox.field_res_config_settings__mapbox_token
msgid ""
"Public Mapbox access token used by the Mapbox form widget. Create a token at"
" https://account.mapbox.com/."
msgstr ""
"Token di accesso pubblico Mapbox utilizzato dal widget del modulo Mapbox. "
"Crea un token su https://account.mapbox.com/."

#. module: web_widget_mapbox
#: model_terms:ir.ui.view,arch_db:web_widget_mapbox.res_config_settings_view_form
msgid ""
"Public Mapbox token for the Mapbox form widget. This is not the Enterprise "
"Map view token."
msgstr ""
"Token pubblico Mapbox per il widget del modulo Mapbox. Non si tratta del "
"token Enterprise per la visualizzazione della mappa."

#. module: web_widget_mapbox
