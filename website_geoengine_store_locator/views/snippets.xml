<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="website_geoengine_store_locator_snippets"
        name="Snippet Store Locator"
        inherit_id="website.snippets"
        priority="8"
    >
        <xpath expr="//t[@id='installed_snippets_hook']" position="after">
            <t
                snippet-group="geoengine"
                t-snippet="website.s_snippet_group"
                string="Store Locator"
                t-thumbnail="/website_geoengine_store_locator/static/src/img/s_map.svg"
            />
        </xpath>

        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t
                t-snippet="website_geoengine_store_locator.s_openlayer_store_locator"
                string="Store Locator"
                group="geoengine"
                t-thumbnail="/website_geoengine_store_locator/static/src/img/s_openlayer_store_locator.png"
                t-image-preview="/website_geoengine_store_locator/static/src/img/s_openlayer_store_locator_preview.png"
            >
                <keywords>
                    map, maps, store, store locator, shop, shop finder, locations, location, finder, find us, branch, retailer, dealer, address, contact, local, directions, navigation, geolocation, geo, openlayers, openstreetmap, osm, ecommerce, e-commerce
                </keywords>
            </t>
        </xpath>
    </template>
</odoo>
