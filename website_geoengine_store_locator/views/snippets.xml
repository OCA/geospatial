<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="website_geoengine_store_locator_snipet"
        inherit_id="website.snippets"
        priority="8"
    >
        <xpath expr="//snippets[@id='snippet_groups']" position="before">
            <snippets id="geoengine_snippet_groups" string="OCA/Geospatial">
                <t
                    snippet-group="geoengine"
                    string="GeoEngine"
                    t-thumbnail="/website_geoengine_store_locator/static/src/img/snippets_thumbs/s_map.svg"
                />
            </snippets>
            <snippets id="geoengine_snippet_structure" string="OCA/Geospatial">
                <t
                    t-snippet="website_geoengine_store_locator.s_openlayer_store_locator"
                    group="geoengine"
                    t-thumbnail="/website_geoengine_store_locator/static/src/img/snippets_thumbs/s_openlayer_store_locator.png"
                    string="Store Locator"
                >
                    <keywords>map, store</keywords>
                </t>
            </snippets>
        </xpath>
    </template>
</odoo>
