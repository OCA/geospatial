<templates xml:space="preserve">

    <!--
        Empty button template for control panel
        Can be extended by custom views to add buttons
    -->
    <t t-name="web_view_leaflet_map.LeafletMapView.Buttons" owl="1" />

    <!--
        LeafletMapController template
        Main view controller with Layout wrapper and search components
        Follows the pattern from graphView in Odoo core
    -->
    <t t-name="web_view_leaflet_map.LeafletMapController" owl="1">
        <div t-att-class="props.className" t-ref="root">
            <Layout
                className="model.useSampleModel ? 'o_view_sample_data' : ''"
                display="props.display"
            >
                <!-- Cog Menu (settings/export) in control panel -->
                <t t-set-slot="control-panel-additional-actions">
                    <CogMenu />
                </t>

                <!-- Search Bar in layout actions -->
                <t t-set-slot="layout-actions">
                    <SearchBar toggler="searchBarToggler" />
                </t>

                <!-- Search Bar Toggler for mobile -->
                <t t-set-slot="control-panel-navigation-additional">
                    <t
                        t-component="searchBarToggler.component"
                        t-props="searchBarToggler.props"
                    />
                </t>

                <!-- Main content: Renderer or NoContent helper -->
                <t t-if="model.data">
                    <t
                        t-if="!model.hasData() and props.info and props.info.noContentHelp"
                        t-call="web.ActionHelper"
                    >
                        <t t-set="noContentHelp" t-value="props.info.noContentHelp" />
                    </t>
                    <t t-component="props.Renderer" t-props="rendererProps" />
                </t>
            </Layout>
        </div>
    </t>

    <!--
        LeafletMapRenderer template
        Map renderer with sidebar and map container
    -->
    <t t-name="web_view_leaflet_map.LeafletMapRenderer" owl="1">
        <div class="o_leaflet_main_container h-100">
            <!-- Sidebar Pin List -->
            <t t-if="showPinList">
                <t
                    t-component="PinListComponent"
                    records="records"
                    groupBy="groupBy"
                    groupColors="groupColors"
                    panelTitle="panelTitle"
                    onPinClick.bind="onPinClick"
                    onNavigateClick.bind="onNavigateClick"
                    onResequence.bind="onResequence"
                    fieldTitle="fieldTitle"
                    fieldAddress="fieldAddress"
                    fieldLatitude="fieldLatitude"
                    fieldLongitude="fieldLongitude"
                    groupField="groupField"
                    unassignedGroupName="unassignedGroupName"
                />
            </t>
            <!-- Map Container -->
            <div class="o_leaflet_map_wrapper h-100">
                <div t-ref="mapContainer" class="o_leaflet_map_container h-100" />
                <!-- Loading Overlay -->
                <t t-if="loading">
                    <div class="o_leaflet_loading_overlay">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </t>

</templates>
