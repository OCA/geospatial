<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_ogcapi_collection_tree" model="ir.ui.view">
        <field name="name">ogcapi.collection.tree</field>
        <field name="model">ogcapi.collection</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="title" />
                <field name="api_id" />
                <field name="model_id" />
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_ogcapi_collection_form" model="ir.ui.view">
        <field name="name">ogcapi.collection.form</field>
        <field name="model">ogcapi.collection</field>
        <field name="arch" type="xml">
            <form string="OGC API Collection">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                            name="action_api_collection_items"
                            icon="fa-building-o" string="Items" />
                    </div>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="title" />
                            <field name="description" />
                            <field name="api_id" />
                            <field name="model_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="geo_field_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="max_features" />
                            <field name="keywords" widget="many2many_tags" />

                        </group>
                        <group string="Geometry Properties">
                            <field name="geo_field_name" />
                            <field name="geo_type" />
                            <field name="geo_srid" />
                            <field name="geo_dimension" />
                            
                        </group>
                        <group string="View Fields">
                            <field name="geo_view_fields" />
                        </group>
                        <group string="Extent">
                            <field name="extent" />
                            <button name="action_calculate_extent" type="object"
                                string="Calculate Extent" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- Action -->
    <record id="action_ogcapi_collection" model="ir.actions.act_window">
        <field name="name">OGC API Collections</field>
        <field name="res_model">ogcapi.collection</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p>You can manage OGC API collections here.</p>
        </field>
    </record>
</odoo>