<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- OGC API Schema form view -->
    <record id="view_ogcapi_component_schema_form" model="ir.ui.view">
        <field name="name">ogcapi.component.schema.form</field>
        <field name="model">ogcapi.component.schema</field>
        <field name="arch" type="xml">
            <form string="OGC API Schema Configuration">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="code" />
                        <field name="description" />
                        <field name="schema_type" />
                        <field name="parent_ids" widget="many2many_tags" />
                    </group>
                    <notebook>
                        <page string="JSON Schema">
                            <field name="schema_text" widget="ace" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ogcapi_component_schema" model="ir.actions.act_window">
        <field name="name">OGC API Schema Configurations</field>
        <field name="res_model">ogcapi.component.schema</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p>Manage OGC API schema configurations here.</p>
        </field>
    </record>
</odoo>
