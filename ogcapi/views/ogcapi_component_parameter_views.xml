<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- OGC API Parameter form view -->
    <record id="view_ogcapi_component_parameter_form" model="ir.ui.view">
        <field name="name">ogcapi.component.parameter.form</field>
        <field name="model">ogcapi.component.parameter</field>
        <field name="arch" type="xml">
            <form string="OGC API Parameter">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="code" />
                            <field name="description" />
                            <field name="parameter_in" />
                            <field name="sequence" />
                            <field name="required" />
                            <field name="parameter_type" />
                        </group>
                        <group>
                            <field name="enum" />
                            <field name="minimum" />
                            <field name="maximum" />
                            <field name="default" />
                            <field name="items_type" />
                            <field name="items_min" />
                            <field name="items_max" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ogcapi_component_parameter" model="ir.actions.act_window">
        <field name="name">OGC API Parameter Configurations</field>
        <field name="res_model">ogcapi.component.parameter</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p>Manage OGC API parameter configurations here.</p>
        </field>
    </record>
</odoo>
