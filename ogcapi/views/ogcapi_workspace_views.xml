<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_ogcapi_workspace_tree" model="ir.ui.view">
        <field name="name">ogcapi.workspace.tree</field>
        <field name="model">ogcapi.workspace</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="slug" />
                <field name="description" />
            </tree>
        </field>
    </record>

    <record id="view_ogcapi_workspace_form" model="ir.ui.view">
        <field name="name">ogcapi.workspace.form</field>
        <field name="model">ogcapi.workspace</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            class="oe_stat_button"
                            type="object"
                            name="action_workspace_collections"
                            icon="fa-building-o"
                            string="Collections"
                        />
                    </div>
                    <group>
                        <field name="name" />
                        <field name="slug" />
                        <field name="display_name" />
                        <field name="title" />
                        <field name="description" />
                        <field name="contact_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ogcapi_workspace" model="ir.actions.act_window">
        <field name="name">Workspace</field>
        <field name="res_model">ogcapi.workspace</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p>You can manage OGC API Workspace records from here.</p>
        </field>
    </record>
</odoo>
